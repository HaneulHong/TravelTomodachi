# 이 파일을 .env.local 로 복사해서 값을 채우세요.
# .env.local 은 .gitignore에 걸려 있어 커밋되지 않습니다.
#
#   cp .env.example .env.local
#
# 값을 채운 뒤에는 dev 서버를 재시작해야 반영됩니다 (Vite는 env를 시작 시 읽음).
# 키가 없어도 앱은 동작합니다 — 지도만 개략도로 표시됩니다.
# 발급 절차는 docs/MAP_SETUP.md

# ── Google Maps (한국 제외 전 세계) ─────────────────────────────────
# Google Cloud Console에서 발급. Maps JavaScript API 활성화 필요.
# 반드시 HTTP 리퍼러 제한 + API 제한을 걸어두세요.
VITE_GOOGLE_MAPS_API_KEY=

# Advanced Marker에 필수입니다. 비워두면 DEMO_MAP_ID로 동작하지만
# 개발 전용이므로 배포 전에 실제 Map ID를 발급해 넣으세요.
VITE_GOOGLE_MAPS_MAP_ID=

# ── 카카오맵 (국내) ─────────────────────────────────────────────────
# Kakao Developers > 앱 설정 > 앱 키 > "JavaScript 키"
# ⚠️ 플랫폼 > Web > 사이트 도메인에 http://localhost:5173 을 등록해야 합니다.
#    등록하지 않으면 키가 맞아도 401이 돌아옵니다.
VITE_KAKAO_MAPS_JS_KEY=

# ── 배포 주소 (초대 링크 생성에 사용) ───────────────────────────────
# 비워두면 현재 접속한 origin을 씁니다. 로컬 개발에서는 비워두면 됩니다.
VITE_PUBLIC_BASE_URL=

# ── Supabase (로그인·공유) ──────────────────────────────────────────
# 없으면 로그인은 개발용 목으로 동작합니다 (이 브라우저에만 남는 세션).
# 발급 절차는 docs/AUTH_SETUP.md
#
# 대시보드: Project Settings → API Keys
#
# 공개 키는 브라우저에 노출되도록 설계된 키라 넣어도 안전합니다 —
# 접근 제어는 키가 아니라 RLS(행 수준 보안)가 합니다.
# ⚠️ secret / service_role 키는 절대 넣지 마세요. RLS를 통째로 우회합니다.
VITE_SUPABASE_URL=

# 새 이름 (sb_publishable_... 로 시작). 새로 만든 프로젝트는 이걸 줍니다.
VITE_SUPABASE_PUBLISHABLE_KEY=

# 옛 이름 (eyJ... JWT 모양). 2026년 말 지원 종료 예정.
# 대시보드에 anon만 보이면 여기에 넣으세요. 위를 채웠다면 비워둬도 됩니다.
VITE_SUPABASE_ANON_KEY=
