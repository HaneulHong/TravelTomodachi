{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "dev-attach",
      "port": 5173,
      "autoPort": false,
      "url": "http://localhost:5173"
    },
    {
      "name": "prod-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
